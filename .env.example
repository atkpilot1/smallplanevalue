# Required for local Nuxt (valuations, FAA lookup, feedback)
ANTHROPIC_API_KEY=

# Local Supabase — run `npm run db:start` (keys below are the public local defaults).
# The same URL + anon key are exposed to the browser for Auth (OTP sign-in).
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Optional model overrides
# SPV_MODEL_MAIN=claude-sonnet-4-6
# SPV_MODEL_FAST=claude-haiku-4-5-20251001

# Local service role (Playwright admin REST + GoTrue + credit RPCs). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# Stripe (server only, required). The process exits on startup if these are
# unset. For `nuxt dev`, copy the placeholders from `.env.test` or set real
# test keys. Playwright and `npm run start:e2e` load `.env.test` themselves.
# Real test keys are only needed to click through hosted Checkout locally.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_PACK=

# FAA registry ingest only (.github/scripts/update_faa_registry.py)
# SUPABASE_SERVICE_KEY=
# FAA_ZIP_URL=
# FAA_LOCAL_PATH=
